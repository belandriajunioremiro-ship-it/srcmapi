# ============================================================
# SRCM Backend — Variables de entorno
# Copia este archivo a ".env" y coloca tus valores reales.
# NUNCA subas el archivo ".env" real a git (ya está en .gitignore).
# ============================================================

# --- Supabase / PostgreSQL ---
# La encuentras en Supabase → Project Settings → Database → Connection string (URI)
# Usa el modo "Session" (puerto 5432) para migraciones/Alembic, o
# "Transaction" (puerto 6543, pgbouncer) para la app en producción.
DATABASE_URL=postgresql+psycopg2://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres

# --- Supabase API (para validar tokens emitidos por Supabase Auth) ---
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
# JWT Secret: Supabase → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=TU_JWT_SECRET

# --- Seguridad de la API ---
# Genera uno propio con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Aplicación ---
APP_NAME=SRCM API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS: dominios permitidos, separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Almacenamiento de archivos (fotos de inmuebles, PDFs generados) ---
# Bucket de Supabase Storage donde se guardan fotos/PDFs
SUPABASE_STORAGE_BUCKET=catastro-archivos

# --- Configuración catastral por defecto (debe coincidir con la BD) ---
CODIGO_ESTADO=20
CODIGO_MUNICIPIO=27
CODIGO_PARROQUIA=01
SRID_UTM=2201
